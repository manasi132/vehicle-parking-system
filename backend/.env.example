# Vehicle Parking System - Backend Environment

PORT=5000
NODE_ENV=development

# Development database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/vps_dev?retryWrites=true&w=majority

# Dedicated test database
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@<cluster-host>/vps_test?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Stripe test-mode key only; never commit the real value.
STRIPE_SECRET_KEY=
PAYMENT_CURRENCY=inr

# Optional: approved HTTPS email/SMS relay for password reset OTP.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

# Set to 1 only for a MongoDB replica set or sharded cluster.
REALTIME_MONGO_CHANGE_STREAM=0
