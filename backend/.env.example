# Vehicle Parking System - Backend Environment

PORT=5000
NODE_ENV=development

# Development database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/vps_dev?retryWrites=true&w=majority

# Dedicated test database
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@<cluster-host>/vps_test?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret

# Production password-reset delivery relay (HTTPS endpoint required).
# The relay accepts POST JSON with event, userId, channel, destination,
# otp, and expiresInMinutes; authenticate it with the bearer token below.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

CLIENT_ORIGIN=http://localhost:5173
